+            );
         }
+        out
     } else {
+        if std::env::var("RHWP_LH_DIAG").is_ok() {
+            eprintln!(
+                "LH_PASSTHRU ls_type={:?} raw_lh={:.2} max_fs={:.2} ls_val={:.1}",
+                ls_type, raw_lh, max_fs, ls_val
+            );
+        }
         raw_lh
     }
 }
